{
  "name": "tech-tombola-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "bun src/db/migrate.ts",
    "db:check": "bun src/db/check.ts",
    "test": "bun test tests/unit src/modules/claims/*.test.ts src/modules/live/*.test.ts src/realtime/*.test.ts",
    "test:integration": "bun test --parallel=1 tests/integration src/realtime/realtime.routes.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/websocket": "^11.3.4",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2"
  }
}
